+#[test]
+fn proposed_duplicate_metadata_cannot_mask_an_unknown_protocol_version() {
+    for (fields, id, epoch) in [
+        (r#""requestId":8,"helperEpoch":5,"helperEpoch":5"#, Some(8u64), None),
+        (r#""requestId":8,"requestId":8,"helperEpoch":5"#, None, Some(5u64)),
+        (r#""requestId":8,"helperEpoch":5,"params":{},"params":{}"#, Some(8), Some(5)),
+    ] {
+        let (_fixture, mut h, session_epoch) = started();
+        h.send_text(&format!(r#"{{"protocolVersion":2,{fields},"method":"x"}}"#));
+        let reply = h.recv();
+        assert_eq!(reply["error"]["detail"], "unsupported_protocol_version");
+        assert_eq!(reply["requestId"], json!(id));
+        assert_eq!(reply["helperEpoch"], json!(epoch.unwrap_or(session_epoch)));
+        assert_eq!(h.exit_code_only(), protocol::exit::PROTOCOL_FATAL);
+    }
+}
+
+#[test]
+fn proposed_tolerant_probe_does_not_relax_version_one_duplicate_rejection() {
+    let (_fixture, mut h, epoch) = started();
+    h.send_text(&format!(r#"{{"protocolVersion":1,"requestId":8,"helperEpoch":{epoch},"helperEpoch":{epoch},"method":"x"}}"#));
+    let reply = h.recv();
+    assert_eq!(reply["error"]["detail"], "invalid_envelope");
+    assert!(reply["requestId"].is_null());
+    assert_eq!(reply["helperEpoch"], json!(epoch));
+    shutdown_ok(&mut h, epoch, 9);
+    assert_eq!(h.exit_code_only(), 0);
+}
